# ============================================
# AI Agent 环境变量配置
# ============================================
#
# 复制此文件为 .env.local 并填入你的 API Key
# cp .env.local.example .env.local
#
# 只需要配置你要使用的模型的 API Key
#
# ============================================

# ---- OpenAI 系列 ----
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Anthropic Claude 系列 ----
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- DeepSeek 系列 ----
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- Moonshot / Kimi 系列 ----
# 获取地址: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# ---- 通义千问 系列 ----
# 获取地址: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=

# ---- 智谱 GLM 系列 ----
# 获取地址: https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=

# ---- 文心一言 系列 ----
# 获取地址: https://console.bce.baidu.com/qianfan/ais/console/applicationConsole/application
ERNIE_API_KEY=

# ---- 火山引擎大模型 (Volcengine/豆包) 系列 ----
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLC_API_KEY=

# ---- 讯飞星火 系列 ----
# 获取地址: https://console.xfyun.cn/services/bm4
SPARK_API_KEY=

# ---- 搜索 API（可选，用于 web_search 工具）----
# 获取地址: https://tavily.com/
TAVILY_API_KEY=

# ============================================
# IM 机器人（飞书 / Telegram）配置
# ============================================
# 让用户在飞书/Telegram 里直接跟 chatClaw 对话。
# 模型密钥：直接复用上面的 OPENAI_API_KEY / DEEPSEEK_API_KEY 等（不需要额外配置），
# 或单独指定：
# IM_AGENT_MODEL=openai-gpt-4o        # 机器人使用的模型 ID（见 src/lib/llm/models.ts）
# IM_AGENT_API_KEY=                   # 可选，覆盖模型默认环境变量
# IM_AGENT_BASE_URL=                  # 可选，覆盖模型默认 API 地址

# ---- 飞书机器人（企业自建应用）----
# 获取: https://open.feishu.cn 创建「企业自建应用」→ 凭证与基础信息
# 需权限: im:message（读取与发送消息）；事件订阅地址填 <公网>/api/im/feishu
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ---- Telegram 机器人 ----
# 获取: 找 @BotFather 发 /newbot 创建，拿 token
# 注册 webhook: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<公网>/api/im/telegram"
# TELEGRAM_BOT_TOKEN=

# ============================================
# 自定义模型 API Key 示例
# ============================================
# 如果你添加了自定义模型，需要配置对应的 API Key
# 例如：CUSTOM_MYMODEL_API_KEY=your_api_key_here
#
