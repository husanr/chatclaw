# ============================================
# AI Agent 环境变量配置
# ============================================
#
# 复制此文件为 .env.local 并填入你的 API Key
# cp .env.local.example .env.local
#
# 只需要配置你要使用的模型的 API Key
#
# ============================================

# ---- OpenAI 系列 ----
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Anthropic Claude 系列 ----
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- DeepSeek 系列 ----
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- Moonshot / Kimi 系列 ----
# 获取地址: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# ---- 通义千问 系列 ----
# 获取地址: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=

# ---- 智谱 GLM 系列 ----
# 获取地址: https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=

# ---- 文心一言 系列 ----
# 获取地址: https://console.bce.baidu.com/qianfan/ais/console/applicationConsole/application
ERNIE_API_KEY=

# ---- 火山引擎大模型 (Volcengine/豆包) 系列 ----
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLC_API_KEY=

# ---- 讯飞星火 系列 ----
# 获取地址: https://console.xfyun.cn/services/bm4
SPARK_API_KEY=

# ---- 搜索 API（可选，用于 web_search 工具）----
# 获取地址: https://tavily.com/
TAVILY_API_KEY=

# ============================================
# 自定义模型 API Key 示例
# ============================================
# 如果你添加了自定义模型，需要配置对应的 API Key
# 例如：CUSTOM_MYMODEL_API_KEY=your_api_key_here
#
